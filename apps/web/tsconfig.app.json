{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "@fde/ui": ["../../packages/ui/src/index.ts"],
      "@fde/content-schema": ["../../packages/content-schema/src/index.ts"]
    },
    "noEmit": true
  },
  "include": ["src"]
}
