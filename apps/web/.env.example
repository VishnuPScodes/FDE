# Local development environment variables for the web app
# Copy this to .env.local (not committed to git)

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
VITE_API_URL=http://localhost:8787
# Local-only testing switch: set true to bypass level prerequisite locks.
VITE_UNLOCK_ALL_LEVELS=false
